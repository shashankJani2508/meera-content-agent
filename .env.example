# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.   (cp .env.example .env)
# .env is listed in .gitignore - it must never be committed to GitHub.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# See README.md → "Environment variables" for where to get each one.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather (looks like 1234567890:AAE...).            REQUIRED
TELEGRAM_BOT_TOKEN=

# A long random string you make up. Telegram sends it back with every webhook
# call so the app can reject requests that didn't come from Telegram.  REQUIRED
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated chat IDs allowed to use the bot (send /start to the bot to
# see yours). Leave empty only while setting up - anyone could use the bot.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── AI ──────────────────────────────────────────────────────────────────────
# Google AI Studio key. Used for scoring, keywords and news relevance.  REQUIRED
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash.
GEMINI_MODEL=

# Anthropic key. Used for drafting. If empty, drafting falls back to Gemini.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
CLAUDE_MODEL=

# Optional: "claude" or "gemini". Leave empty for automatic
# (Claude when ANTHROPIC_API_KEY is set, otherwise Gemini).
DRAFTING_PROVIDER=

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL, e.g. https://abcdefghijklmnop.supabase.co                REQUIRED
SUPABASE_URL=
# Server-side secret key (legacy "service_role" key or new "sb_secret_..." key).
# Only ever used on the server. Never put it in browser code.           REQUIRED
SUPABASE_SERVICE_ROLE_KEY=
